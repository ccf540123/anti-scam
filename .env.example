# 本機開發：複製此檔為 .env 後填入真實金鑰
# 正式部署：到 Render Dashboard 的 Environment 設定同樣的變數
# 絕對不要把填好的 .env commit 到 GitHub

GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# GitHub Pages 網址，例如：
# https://ccf540123.github.io
# 或專案頁：https://ccf540123.github.io/anti-scam-LINE-bot
# 本機測試可先用 *
FRONTEND_ORIGIN=*

# 研究小組 Review 共同密碼（只放後端／Render Environment）
REVIEW_PASSWORD=change_me_research_group_password

# Flask session 簽名用（正式環境請設成一長串隨機字串）
FLASK_SECRET_KEY=change_me_to_a_long_random_string

# PTT Review answers（正式：GitHub Pages 前端直連 Supabase）
# 前端 docs/review/config.js 使用 anon public key + RLS
# 下列變數僅給本機 Flask／腳本可選後備，Pages 不需要 service_role
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key_here
# 可選（不要放到前端 / GitHub Pages）
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
